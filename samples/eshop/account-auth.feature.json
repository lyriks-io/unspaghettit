  "feature": {
    "id": "941e4158",
    "name": "Account & auth",
    "description": "Sign up, sign in, and verify email. Locks out repeated failures, caps verification retries, and sends a welcome email after signup.",
    "surfaces": [
      {
        "id": "86fcdef9",
        "name": "Sign up",
