{
  "name": "unspaghettit",
  "version": "0.1.6",
  "type": "module",
  "description": "Executable specifications for AI-assisted software development. Local-first and MCP-native.",
  "author": {
    "name": "Lyriks.io",
    "url": "https://lyriks.io"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "behavior-modeling",
    "spec",
    "simulator",
    "sveltekit",
    "claude",
    "cursor",
    "gemini"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/lyriks-io/unspaghettit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyriks-io/unspaghettit.git"
  },
  "bugs": {
    "url": "https://github.com/lyriks-io/unspaghettit/issues"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx mcp-server/bin.ts",
    "seed:snapshots": "tsx mcp-server/seed-snapshots.ts",
    "migrate:defaults": "tsx mcp-server/migrate-defaults.ts",
    "unspa": "node cli/unspa.cjs",
    "skills:sync": "node scripts/sync-skills.cjs",
    "skills:check": "node scripts/sync-skills.cjs --check",
    "bom:strip": "node scripts/strip-bom.cjs",
    "bom:check": "node scripts/strip-bom.cjs --check",
    "prepublishOnly": "npm run skills:check && npm run bom:check && npm run build && npm test"
  },
  "bin": {
    "unspa": "./cli/unspa.cjs",
    "unspaghettit": "./cli/unspaghettit.cjs",
    "unspa-mcp": "./mcp-server/bin.cjs"
  },
  "files": [
    "build",
    "cli",
    "mcp-server",
    "samples",
    "src",
    "static",
    "svelte.config.js",
    "tsconfig.runtime.json",
    "vite.config.ts",
    "LICENSE",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.js",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.spec.js",
    "!**/__tests__",
    "!**/__snapshots__"
  ],
  "overrides": {
    "cookie": ">=0.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "fast-json-patch": "^3.1.1",
    "lib0": "^0.2.117",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "tsx": "^4.21.0",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.20.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  }
}
